{
  "name": "opvtt-desktop-react",
  "version": "1.0.0",
  "private": true,
  "description": "Open Virtual Table Top desktop application",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist:win": "npm run typecheck && npm run build && electron-builder --win nsis --x64",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sql.js": "^1.15.1",
    "ws": "^8.18.3",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.7.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/sql.js": "^1.4.11",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "build": {
    "appId": "com.opvtt.desktop",
    "productName": "OPVTT",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "OPVTT-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OPVTT"
    }
  },
  "allowScripts": {
    "electron@45.0.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
